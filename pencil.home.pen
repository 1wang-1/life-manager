{
  "meta": { "app": "Life Manager Desktop", "version": "1.0", "page": "Home" },
  "tokensRef": "./pencil.design.json",
  "frame": {
    "id": "home-root",
    "type": "frame",
    "size": { "width": 1600, "height": 1200 },
    "grid": { "cols": 12, "gap": 24, "padding": 48, "maxWidth": 1600 },
    "children": [
      {
        "id": "header",
        "type": "group",
        "layout": { "x": 48, "y": 32, "w": 1504, "h": 64 },
        "children": [
          { "id": "title", "type": "text", "value": "早安，开始专注", "typography": "h1", "color": "{color.textMain}", "layout": { "x": 0, "y": 0, "w": 400, "h": 32 } },
          { "id": "date", "type": "text", "value": "2月4日 周三", "typography": "secondary", "color": "{color.textSecondary}", "layout": { "x": 0, "y": 36, "w": 300, "h": 20 } },
          { "id": "summary-left", "type": "card", "variant": "default", "style": { "radius": "{radii.card}" }, "layout": { "x": 1150, "y": 0, "w": 168, "h": 64 }, "children": [
            { "id": "label1", "type": "text", "value": "今日完成", "typography": "caption", "color": "{color.textSecondary}", "layout": { "x": 12, "y": 10, "w": 80, "h": 16 } },
            { "id": "value1", "type": "text", "value": "1/8", "typography": "h2", "color": "{color.textMain}", "layout": { "x": 12, "y": 30, "w": 60, "h": 24 } }
          ] },
          { "id": "summary-right", "type": "card", "variant": "default", "style": { "radius": "{radii.card}" }, "layout": { "x": 1330, "y": 0, "w": 168, "h": 64 }, "children": [
            { "id": "label2", "type": "text", "value": "专注时长", "typography": "caption", "color": "{color.textSecondary}", "layout": { "x": 12, "y": 10, "w": 80, "h": 16 } },
            { "id": "value2", "type": "text", "value": "0 min", "typography": "h2", "color": "{color.textMain}", "layout": { "x": 12, "y": 30, "w": 80, "h": 24 } }
          ] }
        ]
      },
      {
        "id": "left-col",
        "type": "group",
        "layout": { "x": 48, "y": 128, "w": 1024, "h": 700 },
        "children": [
          {
            "id": "timer-card",
            "type": "card",
            "variant": "emphasis",
            "style": { "radius": "{radii.card}" },
            "layout": { "x": 0, "y": 0, "w": 1024, "h": 420 },
            "children": [
              { "id": "status", "type": "text", "value": "READY", "typography": "caption", "color": "{color.textMuted}", "layout": { "x": 24, "y": 20, "w": 80, "h": 16 } },
              { "id": "tabs", "type": "group", "layout": { "x": 880, "y": 16, "w": 120, "h": 28 }, "children": [
                { "id": "tab-pomodoro", "type": "tab", "state": "selected", "label": "番茄", "layout": { "x": 0, "y": 0, "w": 40, "h": 28 } },
                { "id": "tab-countdown", "type": "tab", "state": "default", "label": "倒计时", "layout": { "x": 44, "y": 0, "w": 60, "h": 28 } },
                { "id": "tab-stopwatch", "type": "tab", "state": "default", "label": "正向计时", "layout": { "x": 108, "y": 0, "w": 84, "h": 28 } }
              ] },
              { "id": "time", "type": "text", "value": "25:00", "typography": "h1", "color": "{color.textMain}", "layout": { "x": 432, "y": 120, "w": 160, "h": 64 } },
              { "id": "play", "type": "play-button", "state": "idle", "layout": { "x": 476, "y": 220, "w": 72, "h": 72 } },
              { "id": "current-task", "type": "text", "value": "做我爱做", "typography": "secondary", "color": "{color.textSecondary}", "layout": { "x": 468, "y": 200, "w": 120, "h": 20 } }
            ]
          },
          {
            "id": "stats-row",
            "type": "group",
            "layout": { "x": 0, "y": 440, "w": 1024, "h": 260 },
            "children": [
              { "id": "trend", "type": "card", "variant": "default", "style": { "radius": "{radii.card}" }, "layout": { "x": 0, "y": 0, "w": 496, "h": 260 }, "children": [
                { "id": "trend-title", "type": "text", "value": "专注趋势", "typography": "h2", "color": "{color.textMain}", "layout": { "x": 24, "y": 20, "w": 100, "h": 24 } },
                { "id": "trend-sub", "type": "text", "value": "近7天", "typography": "caption", "color": "{color.textSecondary}", "layout": { "x": 24, "y": 48, "w": 100, "h": 16 } },
                { "id": "trend-chart", "type": "rect", "variant": "placeholder", "layout": { "x": 24, "y": 80, "w": 448, "h": 156 }, "style": { "radius": 12 } }
              ] },
              { "id": "top", "type": "card", "variant": "default", "style": { "radius": "{radii.card}" }, "layout": { "x": 528, "y": 0, "w": 496, "h": 260 }, "children": [
                { "id": "top-title", "type": "text", "value": "Top 专注", "typography": "h2", "color": "{color.textMain}", "layout": { "x": 24, "y": 20, "w": 100, "h": 24 } },
                { "id": "top-item-1", "type": "listItem", "variant": "default", "layout": { "x": 24, "y": 72, "w": 448, "h": 44 }, "children": [
                  { "id": "top-rank-1", "type": "badge", "value": "1", "layout": { "x": 12, "y": 12, "w": 20, "h": 20 } },
                  { "id": "top-name-1", "type": "text", "value": "做我爱做", "typography": "secondary", "color": "{color.textMain}", "layout": { "x": 44, "y": 12, "w": 240, "h": 20 } },
                  { "id": "top-time-1", "type": "text", "value": "25m", "typography": "secondary", "color": "{color.textSecondary}", "layout": { "x": 400, "y": 12, "w": 40, "h": 20 } }
                ] },
                { "id": "top-item-2", "type": "listItem", "variant": "default", "layout": { "x": 24, "y": 124, "w": 448, "h": 44 }, "children": [
                  { "id": "top-rank-2", "type": "badge", "value": "2", "layout": { "x": 12, "y": 12, "w": 20, "h": 20 } },
                  { "id": "top-name-2", "type": "text", "value": "阅读", "typography": "secondary", "color": "{color.textMain}", "layout": { "x": 44, "y": 12, "w": 240, "h": 20 } },
                  { "id": "top-time-2", "type": "text", "value": "10m", "typography": "secondary", "color": "{color.textSecondary}", "layout": { "x": 400, "y": 12, "w": 40, "h": 20 } }
                ] },
                { "id": "top-item-3", "type": "listItem", "variant": "default", "layout": { "x": 24, "y": 176, "w": 448, "h": 44 }, "children": [
                  { "id": "top-rank-3", "type": "badge", "value": "3", "layout": { "x": 12, "y": 12, "w": 20, "h": 20 } },
                  { "id": "top-name-3", "type": "text", "value": "运动", "typography": "secondary", "color": "{color.textMain}", "layout": { "x": 44, "y": 12, "w": 240, "h": 20 } },
                  { "id": "top-time-3", "type": "text", "value": "5m", "typography": "secondary", "color": "{color.textSecondary}", "layout": { "x": 400, "y": 12, "w": 40, "h": 20 } }
                ] }
              ] }
            ]
          }
        ]
      },
      {
        "id": "right-col",
        "type": "group",
        "layout": { "x": 1104, "y": 128, "w": 448, "h": 700 },
        "children": [
          { "id": "todo-card", "type": "card", "variant": "emphasis", "style": { "radius": "{radii.card}" }, "layout": { "x": 0, "y": 0, "w": 448, "h": 700 }, "children": [
            { "id": "todo-title", "type": "text", "value": "今日待办", "typography": "h2", "color": "{color.textMain}", "layout": { "x": 24, "y": 20, "w": 100, "h": 24 } },
            { "id": "todo-input", "type": "input", "variant": "default", "layout": { "x": 24, "y": 56, "w": 320, "h": 40 }, "props": { "placeholder": "快速添加任务..." } },
            { "id": "todo-item-1", "type": "listItem", "variant": "default", "layout": { "x": 24, "y": 112, "w": 400, "h": 48 }, "children": [
              { "id": "todo-item-1-title", "type": "text", "value": "做我爱做", "typography": "body", "color": "{color.textMain}", "layout": { "x": 16, "y": 14, "w": 200, "h": 24 } }
            ] },
            { "id": "todo-item-2", "type": "listItem", "variant": "default", "layout": { "x": 24, "y": 168, "w": 400, "h": 48 }, "children": [
              { "id": "todo-item-2-title", "type": "text", "value": "阅读 20 分钟", "typography": "body", "color": "{color.textMain}", "layout": { "x": 16, "y": 14, "w": 260, "h": 24 } }
            ] },
            { "id": "todo-item-3", "type": "listItem", "variant": "default", "layout": { "x": 24, "y": 224, "w": 400, "h": 48 }, "children": [
              { "id": "todo-item-3-title", "type": "text", "value": "拉伸", "typography": "body", "color": "{color.textMain}", "layout": { "x": 16, "y": 14, "w": 260, "h": 24 } }
            ] }
          ] }
        ]
      }
    ]
  }
}
