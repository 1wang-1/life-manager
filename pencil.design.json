{
  "meta": {
    "app": "Life Manager Desktop",
    "version": "2.1.0",
    "createdAt": "2026-02-05",
    "description": "Minimalist homepage focused on 'Start Focus'"
  },
  "tokens": {
    "color": {
      "primary": "#FFB000",
      "primaryHover": "#F59E0B",
      "onPrimary": "#FFFFFF",
      "bg": "#FFFFFF",
      "bgSubtle": "#F9FAFB",
      "text": "#111827",
      "textSecondary": "#6B7280",
      "textTertiary": "#9CA3AF",
      "border": "#E5E7EB",
      "ringReady": "#E5E7EB",
      "ringActive": "#FFB000"
    },
    "typography": {
      "fontFamily": "Inter, system-ui, sans-serif",
      "timer": {
        "fontSize": "80px",
        "fontWeight": "300",
        "lineHeight": "1",
        "fontVariantNumeric": "tabular-nums"
      },
      "h1": {
        "fontSize": "24px",
        "fontWeight": "600"
      },
      "body": {
        "fontSize": "14px",
        "fontWeight": "400"
      },
      "button": {
        "fontSize": "16px",
        "fontWeight": "500"
      }
    },
    "spacing": {
      "unit": "8px",
      "layout": "24px"
    },
    "radii": {
      "button": "9999px",
      "card": "12px"
    }
  },
  "pages": [
    {
      "id": "home",
      "name": "Home",
      "layout": {
        "type": "grid",
        "template": "1fr 320px / 1fr",
        "description": "Main focus area left/center, Sidebar right"
      },
      "sections": [
        {
          "id": "focus-area",
          "component": "FocusTimerContainer",
          "position": "center",
          "contains": [
            "FocusTimer",
            "GrowthFeedback",
            "CompletedCounter"
          ]
        },
        {
          "id": "sidebar",
          "component": "TodoSidebar",
          "position": "right",
          "contains": [
            "TodoList",
            "QuickAdd"
          ]
        }
      ]
    }
  ],
  "components": [
    {
      "id": "FocusTimer",
      "name": "Focus Timer",
      "props": {
        "time": "25:00",
        "progress": 0,
        "status": "idle | running | paused"
      },
      "elements": [
        {
          "name": "Ring",
          "type": "SVG Circle",
          "style": "Thin stroke, color based on status"
        },
        {
          "name": "TimeDisplay",
          "style": "tokens.typography.timer"
        },
        {
          "name": "CurrentTask",
          "style": "tokens.typography.body, tokens.color.textSecondary"
        },
        {
          "name": "StartButton",
          "text": "开始专注",
          "variant": "primary"
        },
        {
          "name": "FullscreenButton",
          "text": "全屏专注",
          "variant": "secondary"
        }
      ]
    },
    {
      "id": "GrowthFeedback",
      "name": "Growth Feedback",
      "props": {
        "visible": "boolean"
      },
      "elements": [
        {
          "name": "Icon",
          "type": "Plant/Sprout"
        },
        {
          "name": "Text",
          "text": "今日成长 +1"
        }
      ]
    },
    {
      "id": "TodoSidebar",
      "name": "Today Todo",
      "elements": [
        {
          "name": "List",
          "itemType": "TaskTitleOnly"
        },
        {
          "name": "ActiveHighlight",
          "description": "Background/Border for current task"
        }
      ]
    },
    {
      "id": "CompletedCounter",
      "name": "Completed Counter",
      "position": "bottom-left",
      "elements": [
        {
          "name": "Symbol",
          "text": "✓"
        },
        {
          "name": "Count",
          "text": "{number}"
        }
      ]
    }
  ]
}
